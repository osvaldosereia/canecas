# Endereço do webhook de geração no Make (segredo: configurar somente no ambiente)
MAKE_PERSONALIZATION_WEBHOOK_URL=

# Segredo compartilhado entre o site e o Make, usado no envio e no callback
MAKE_WEBHOOK_SECRET=

# Segredo para o cenário do Make enviar novos modelos ao feed
MODEL_FEED_WEBHOOK_SECRET=

# E-mails autorizados no painel, separados por vírgula
ADMIN_EMAILS=

# Preço unitário em centavos. Ex.: 6290 = R$ 62,90
MUG_UNIT_PRICE_CENTS=6290

# Mercado Pago Checkout Pro
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Melhor Envio: use sandbox durante os testes e production somente após homologação
MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_ACCESS_TOKEN=
STORE_ORIGIN_POSTAL_CODE=
STORE_SUPPORT_EMAIL=
